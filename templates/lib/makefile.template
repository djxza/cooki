# ============================================================================
# Project Configuration (from project.json)
# ============================================================================
PROJECT_JSON := project.json

# Extract project settings with error handling
ifneq ("$(wildcard $(PROJECT_JSON))","")
    PROJECT_NAME   := $(shell jq -r '.name' $(PROJECT_JSON))
    PROJECT_TYPE   := $(shell jq -r '.type // "Executable"' $(PROJECT_JSON))
    LANG           := $(shell jq -r '.lang // "C++"' $(PROJECT_JSON))
    COMPILER_PATH  := $(shell jq -r '.compiler_path // ""' $(PROJECT_JSON))
    SRC_EXT        := $(shell jq -r '.ext // ".cpp"' $(PROJECT_JSON))
    SRC_DIR        := $(shell jq -r '.src_dir // "src"' $(PROJECT_JSON))
    BIN_DIR        := $(shell jq -r '.bin_dir // "bin"' $(PROJECT_JSON))
    INC_DIR        := $(shell jq -r '.inc_dir // "include"' $(PROJECT_JSON))
    LIB_DIR        := $(shell jq -r '.lib_dir // "lib"' $(PROJECT_JSON))
    CREATE_TEST    := $(shell jq -r '.create_test // "true"' $(PROJECT_JSON))
    API_PREFIX     := $(shell jq -r '.api_prefix // ""' $(PROJECT_JSON))
else
    $(error "$(PROJECT_JSON) not found! Create it or use defaults")
endif

# Use project name if API prefix is not set
ifeq ($(API_PREFIX),)
    API_PREFIX := $(PROJECT_NAME)
endif

# ============================================================================
# Compiler & Language Configuration
# ============================================================================
# Determine compiler based on language (lang field)
ifeq ($(LANG),C)
    # C project configuration
    ifeq ($(COMPILER_PATH),)
        CC := gcc
    else
        CC := $(COMPILER_PATH)
    endif
    STD := c17
    SRC_FILES := $(shell find $(SRC_DIR) -name "*.c" 2>/dev/null)
else
    # C++ project configuration (default)
    ifeq ($(COMPILER_PATH),)
        CC := g++
    else
        CC := $(COMPILER_PATH)
    endif
    STD := c++26
    SRC_FILES := $(shell find $(SRC_DIR) -name "*.cpp" -o -name "*.cc" -o -name "*.cxx" 2>/dev/null)
endif

# ============================================================================
# Library Configuration
# ============================================================================
OBJ_DIR         := $(BIN_DIR)/obj

# Library names
STATIC_LIB      := $(LIB_DIR)/lib$(PROJECT_NAME).a
SHARED_LIB      := $(LIB_DIR)/lib$(PROJECT_NAME).so

# Object files in bin/obj directory with flat structure
OBJ_FILES       := $(patsubst $(SRC_DIR)/%,$(OBJ_DIR)/%.o,$(basename $(SRC_FILES)))

# Dependency files for auto-rebuild
DEP_FILES       := $(OBJ_FILES:.o=.d)

# ============================================================================
# Compiler & Linker Flags
# ============================================================================
# Warning flags (common for C and C++)
WARNINGS := -Wall -Wextra -Wpedantic \
            -Wshadow -Wunused -Wformat=2

# Language-specific warnings
ifeq ($(LANG),C)
    WARNINGS += -Wstrict-prototypes -Wmissing-prototypes \
                -Wold-style-definition -Wbad-function-cast
else
    WARNINGS += -Wnon-virtual-dtor -Wold-style-cast \
                -Wcast-align -Woverloaded-virtual \
                -Wconversion -Wsign-conversion \
                -Wnull-dereference -Wdouble-promotion
endif

# Optimization flags
ifeq ($(BUILD_TYPE),release)
    OPTIMIZE := -O3 -DNDEBUG -flto=auto
    SHARED_OPTIONS := -O3 -flto=auto
else
    OPTIMIZE := -Og -g3 -DDEBUG
    SHARED_OPTIONS := -Og -g3
    BUILD_TYPE := debug
endif

# Include directories - include the project-specific subdirectory
INCLUDES := -I$(INC_DIR)/$(PROJECT_NAME) -I$(INC_DIR) -I$(SRC_DIR)
LIB_PATHS := -L$(LIB_DIR)

# Position Independent Code for shared libraries
PIC_FLAGS := -fPIC

# Compiler flags
CFLAGS := -std=$(STD) $(WARNINGS) $(OPTIMIZE) $(INCLUDES) \
          -fdiagnostics-color=always \
          -MMD -MP  # Generate dependency files

# Shared library compiler flags
CFLAGS_SHARED := $(CFLAGS) $(PIC_FLAGS)

# Shared library linker flags
LDFLAGS_SHARED := $(SHARED_OPTIONS) -shared -Wl,-soname,lib$(PROJECT_NAME).so

# ============================================================================
# Phony Targets
# ============================================================================
.PHONY: all clean debug release help info dirs static shared install uninstall

# Default target - build both static and shared libraries
all: dirs static shared

# Static library target
static: dirs $(STATIC_LIB)

# Shared library target
shared: dirs $(SHARED_LIB)

# Debug build (default)
debug:
	@$(MAKE) BUILD_TYPE=debug

# Release build
release:
	@$(MAKE) BUILD_TYPE=release

# Clean everything
clean:
	@echo "🧹 Cleaning build artifacts..."
	@rm -rf $(OBJ_DIR) $(STATIC_LIB) $(SHARED_LIB) compile_commands.json

# Create necessary directories
dirs:
	@mkdir -p $(BIN_DIR) $(OBJ_DIR) $(LIB_DIR) $(INC_DIR)/$(PROJECT_NAME)

# Show project info
info:
	@echo "📊 Project Configuration:"
	@echo "  Name:        $(PROJECT_NAME)"
	@echo "  Type:        $(PROJECT_TYPE)"
	@echo "  Language:    $(LANG)"
	@echo "  Compiler:    $(CC)"
	@echo "  Standard:    $(STD)"
	@echo "  Build Type:  $(BUILD_TYPE)"
	@echo "  Source Dir:  $(SRC_DIR)"
	@echo "  Include Dir: $(INC_DIR)/$(PROJECT_NAME)"
	@echo "  Binary Dir:  $(BIN_DIR)"
	@echo "  Library Dir: $(LIB_DIR)"
	@echo "  Object Dir:  $(OBJ_DIR)"
	@echo "  API Prefix:  $(API_PREFIX)"
	@echo "  Create Test: $(CREATE_TEST)"
	@echo "  Static Lib:  $(STATIC_LIB)"
	@echo "  Shared Lib:  $(SHARED_LIB)"
	@echo "  Source Files: $(words $(SRC_FILES))"

# Help message
help:
	@echo "📖 Available targets:"
	@echo "  all      - Build static and shared libraries (default)"
	@echo "  static   - Build only static library"
	@echo "  shared   - Build only shared library"
	@echo "  debug    - Build with debug symbols"
	@echo "  release  - Build with optimizations"
	@echo "  clean    - Remove build artifacts"
	@echo "  dirs     - Create build directories"
	@echo "  info     - Show project configuration"
	@echo "  install  - Install library system-wide"
	@echo "  uninstall - Uninstall library"
	@echo "  help     - Show this help message"
	@echo ""
	@echo "🔧 Build configuration: BUILD_TYPE=$(BUILD_TYPE)"
	@echo ""
	@if [ "$(CREATE_TEST)" = "true" ]; then \
		echo "🧪 Test directory created. To run tests:"; \
		echo "  cd test && make run"; \
	fi

# Install library system-wide
install: release
	@echo "📦 Installing $(PROJECT_NAME) library..."
	@mkdir -p /usr/local/include/$(PROJECT_NAME)
	@cp -r $(INC_DIR)/$(PROJECT_NAME)/*.h* /usr/local/include/$(PROJECT_NAME)/ 2>/dev/null || true
	@cp $(STATIC_LIB) /usr/local/lib/ 2>/dev/null || true
	@cp $(SHARED_LIB) /usr/local/lib/ 2>/dev/null || true
	@ldconfig 2>/dev/null || true
	@echo "✅ $(PROJECT_NAME) installed to /usr/local"

# Uninstall library
uninstall:
	@echo "🗑️  Uninstalling $(PROJECT_NAME) library..."
	@rm -rf /usr/local/include/$(PROJECT_NAME)
	@rm -f /usr/local/lib/lib$(PROJECT_NAME).a
	@rm -f /usr/local/lib/lib$(PROJECT_NAME).so
	@ldconfig 2>/dev/null || true
	@echo "✅ $(PROJECT_NAME) uninstalled"

# ============================================================================
# Build Rules
# ============================================================================
# Build static library
$(STATIC_LIB): $(OBJ_FILES) | dirs
	@echo "📚 Building static library $(notdir $@)..."
	@ar rcs $@ $(OBJ_FILES)
	@echo "✅ Built static library [$(BUILD_TYPE)]"

# Build shared library
$(SHARED_LIB): $(OBJ_FILES) | dirs
	@echo "📚 Building shared library $(notdir $@)..."
	@$(CC) $(OBJ_FILES) $(LDFLAGS_SHARED) -o $@
	@echo "✅ Built shared library [$(BUILD_TYPE)]"

# Compilation rule for C files (static library)
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c | dirs
	@echo "🔨 Compiling $(notdir $<) for static lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@

# Compilation rule for C files (shared library)
$(OBJ_DIR)/%.shared.o: $(SRC_DIR)/%.c | dirs
	@echo "🔨 Compiling $(notdir $<) for shared lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS_SHARED) -c $< -o $@

# Compilation rule for C++ files (static library)
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp | dirs
	@echo "🔨 Compiling $(notdir $<) for static lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cc | dirs
	@echo "🔨 Compiling $(notdir $<) for static lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cxx | dirs
	@echo "🔨 Compiling $(notdir $<) for static lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@

# Compilation rule for C++ files (shared library)
$(OBJ_DIR)/%.shared.o: $(SRC_DIR)/%.cpp | dirs
	@echo "🔨 Compiling $(notdir $<) for shared lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS_SHARED) -c $< -o $@

$(OBJ_DIR)/%.shared.o: $(SRC_DIR)/%.cc | dirs
	@echo "🔨 Compiling $(notdir $<) for shared lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS_SHARED) -c $< -o $@

$(OBJ_DIR)/%.shared.o: $(SRC_DIR)/%.cxx | dirs
	@echo "🔨 Compiling $(notdir $<) for shared lib..."
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS_SHARED) -c $< -o $@

# Include auto-generated dependency files
-include $(DEP_FILES)

# ============================================================================
# Additional Features
# ============================================================================
# Generate compile_commands.json for LSP/tooling
compile_commands.json: $(SRC_FILES)
	@echo "📝 Generating compile_commands.json..."
	@bear -- make -nk 2>/dev/null | grep -A1 "CC=" | tail -n1 > $@ || true

# ============================================================================
# Print variable for debugging
# ============================================================================
print-%:
	@echo '$*=$($*)'
